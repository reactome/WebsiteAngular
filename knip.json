{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "projects/reactome-table-wc/src/main.ts",
    "projects/website-angular/src/scripts/*.{ts,js}",
    "scripts/*.mjs",
    "e2e/**/*.spec.ts",
    "**/*.spec.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "proxy.conf.js",
    "projects/*/src/public-api.ts",
    "projects/*/src/index.ts",
    "projects/website-angular/tina/config.ts",
    "tools/render/{render,service}.mjs",
    "tools/svg-export-harness/*.mjs"
  ],
  "project": ["src/**/*.ts", "projects/**/*.ts", "scripts/**/*.mjs", "tools/**/*.mjs"],
  "ignore": [
    "**/*.d.ts",
    "**/__generated__/**",
    "web-component-demo/**",
    ".claude/**",
    "projects/*/src/types/**"
  ],
  "ignoreDependencies": ["@angular/localize", "zone.js", "tinacms", "swagger-ui-dist"]
}
