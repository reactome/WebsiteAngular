y","className":"Pathway"}],"reviewed":[{"@id":"52","dbId":2172129,"displayName":"D'Eustachio, P, 2012-03-28","dateTime":"2012-03-28 18:03:04","author":[{"@id":"53","dbId":140934,"displayName":"D'Eustachio, P","firstname":"Peter","initial":"P","orcidId":"0000-0002-5494-626X","project":"Reactome","surname":"D'Eustachio","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"54","dbId":9941989,"displayName":"D'Eustachio, Peter, 2025-03-12","dateTime":"2025-03-12 09:33:57","author":[{"@ref":"53"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"55","dbId":9924162,"displayName":"D'Eustachio, Peter, 2024-10-07","dateTime":"2024-10-07 21:28:35","author":[{"@ref":"53"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"56","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"57","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"58","dbId":1636575,"displayName":"Glycosaminoglycans (GAGs) are long, unbranched polysaccharid...","text":"Glycosaminoglycans (GAGs) are long, unbranched polysaccharides containing a repeating disaccharide unit composed of a hexosamine (either N-acetylgalactosamine (GalNAc) or N-acetylglucosamine (GlcNAc)) and a uronic acid (glucuronate or iduronate). They can be heavily sulfated. All GAGs (except hyaluronan) are bound to proteoglycans (PG) via the tetrasaccharide linker -GlcA-Gal-Gal-Xyl- on O-serine residues of the core protein. Hyaluronan and GAG-PGs are located primarily in the extracellular matrix (ECM) and on cell membranes, acting as a lubricating fluid for joints and as part of signalling processes. They have structural roles in connective tissue, cartilage, bone and blood vessels (Esko et al. 2009). GAG-PGs are degraded in the lysosome as part of their natural turnover. Defects in the lysosomal enzymes responsible for the metabolism of membrane-associated GAG-PGs lead to lysosomal storage diseases called mucopolysaccharidoses (MPS). MPSs are characterised by the accumulation of GAGs in lysosomes resulting in chronic, progressively debilitating disorders that in many instances lead to severe psychomotor retardation and premature death (Cantz & Gehler 1976, Clarke 2008).It is unclear but probable that GAG chains are cleaved off PGs, leaving the tetrasaccharide linker on the protein, which then is degraded by β-glucuronidase, two β-galactosidases, and a β-xylosidase. The biosynthesis and breakdown of the main GAG chains (hyaluronate, keratan sulfate, chondroitin sulfate, dermatan sulfate and heparan sulfate) is described here.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"59","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"previousReviewStatus":{"@id":"60","dbId":9821385,"displayName":"four stars","definition":"structure upated after externally reviewed and then internally reviewed","name":["four stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"doi":"10.3180/R-HSA-1630316.6","hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2022-09-14","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"61","dbId":2142845,"displayName":"Hyaluronan metabolism","stId":"R-HSA-2142845","stIdVersion":"R-HSA-2142845.4","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Hyaluronan metabolism"],"releaseDate":"2012-06-12","releaseStatus":"UPDATED","speciesName":"Homo sapiens","goBiologicalProcess":{"@id":"62","dbId":21627,"displayName":"hyaluronan metabolic process","accession":"0030212","databaseName":"GO","definition":"The chemical reactions and pathways involving hyaluronan, the naturally occurring anionic form of hyaluronic acid. Hyaluronan is a type of non-sulfated glycosaminoglycan composed of the repeating disaccharide unit beta(1,4)-D-glucuronic acid-beta(1,3)-N-acetyl-D-glucosamine.","name":"hyaluronan metabolic process","url":"https://www.ebi.ac.uk/QuickGO/term/GO:0030212","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"literatureReference":[{"@id":"63","dbId":2142843,"displayName":"Hyaluronan is not just a goo!","title":"Hyaluronan is not just a goo!","author":[{"@id":"64","dbId":2142880,"displayName":"Toole, BP","initial":"BP","surname":"Toole","className":"Person","schemaClass":"Person","publications":[{"@ref":"63"},{"@id":"65","dbId":2142856,"displayName":"Hyaluronan: from extracellular glue to pericellular cue","title":"Hyaluronan: from extracellular glue to pericellular cue","author":[{"@ref":"64"}],"journal":"Nat Rev Cancer","pages":"528-39","pubMedIdentifier":15229478,"volume":4,"year":2004,"url":"http://www.ncbi.nlm.nih.gov/pubmed/15229478","className":"LiteratureReference","schemaClass":"LiteratureReference"}]}],"journal":"J Clin Invest","pages":"335-6","pubMedIdentifier":10930435,"volume":106,"year":2000,"url":"http://www.ncbi.nlm.nih.gov/pubmed/10930435","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"66","dbId":2142842,"displayName":"Role, metabolism, chemical modifications and applications of hyaluronan","title":"Role, metabolism, chemical modifications and applications of hyaluronan","author":[{"@id":"67","dbId":2142878,"displayName":"Volpi, N","initial":"N","surname":"Volpi","className":"Person","schemaClass":"Person","publications":[{"@ref":"66"}]},{"@id":"68","dbId":2142863,"displayName":"Schiller, J","initial":"J","surname":"Schiller","className":"Person","schemaClass":"Person","publications":[{"@ref":"66"}]},{"@id":"69","dbId":2142887,"displayName":"St