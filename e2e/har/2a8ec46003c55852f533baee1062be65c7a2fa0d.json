1,"displayName":"Manfredi, JJ","firstname":"James J","initial":"JJ","surname":"Manfredi","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"43","dbId":1538129,"displayName":"MacPherson, D, 2011-08-25","dateTime":"2011-08-25 18:28:23","author":[{"@id":"44","dbId":1538131,"displayName":"MacPherson, D","firstname":"David","initial":"D","orcidId":"0000-0003-3729-907X","surname":"MacPherson","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"45","dbId":1527321,"displayName":"Grana, X, 2011-06-15","dateTime":"2011-06-15 23:04:24","author":[{"@id":"46","dbId":1363246,"displayName":"Grana, X","firstname":"Xavier","initial":"X","surname":"Grana","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"revised":[{"@id":"47","dbId":1541744,"displayName":"Orlic-Milacic, Marija, 2011-08-26","dateTime":"2011-08-27 01:24:58","author":[{"@id":"48","dbId":1169272,"displayName":"Orlic-Milacic, M","firstname":"Marija","initial":"M","orcidId":"0000-0002-3218-5631","project":"Reactome","surname":"Orlic-Milacic","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"49","dbId":453275,"displayName":"Matthews, L, 2010-01-19","dateTime":"2010-01-19 18:49:29","author":[{"@ref":"10"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"50","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"51","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"52","dbId":69280,"displayName":"The events of replication of the genome and the subsequent s...","text":"The events of replication of the genome and the subsequent segregation of chromosomes into daughter cells make up the cell cycle. DNA replication is carried out during a discrete temporal period known as the S (synthesis)-phase, and chromosome segregation occurs during a massive reorganization of cellular architecture at mitosis. Two gap-phases separate these cell cycle events: G1 between mitosis and S-phase, and G2 between S-phase and mitosis. Cells can exit the cell cycle for a period and enter a quiescent state known as G0, or terminally differentiate into cells that will not divide again, but undergo morphological development to carry out the wide variety of specialized functions of individual tissues.<p>A family of protein serine/threonine kinases known as the cyclin-dependent kinases (CDKs) controls progression through the cell cycle. As the name suggests, the kinase activity of the catalytic subunits is dependent on binding to cyclin partners, and control of cyclin abundance is one of several mechanisms by which CDK activity is regulated throughout the cell cycle. <p>A complex network of regulatory processes determines whether a quiescent cell (in G0 or early G1) will leave this state and initiate the processes to replicate its chromosomal DNA and divide. This regulation, during the <b>Mitotic G1-G1/S phases</b> of the cell cycle, centers on transcriptional regulation by the DREAM complex, with major roles for D and E type cyclin proteins.<p>Chromosomal DNA synthesis occurs in the <b>S phase</b>, or the synthesis phase, of the cell cycle. The cell duplicates its hereditary material, and two copies of each chromosome are formed. A key aspect of the <b>regulation of DNA</b> replication is the assembly and modification of a pre-replication complex assembled on ORC proteins.<p><b>Mitotic G2-G2/M phases</b> encompass the interval between the completion of DNA synthesis and the beginning of mitosis. During G2, the cytoplasmic content of the cell increases. At G2/M transition, duplicated centrosomes mature and separate and CDK1:cyclin B complexes become active, setting the stage for spindle assembly and chromosome condensation at the start of mitotic <b>M phase</b>. Mitosis, or M phase, results in the generation of two daughter cells each with a complete diploid set of chromosomes. Events of the <b>M/G1 transition</b>, progression out of mitosis and division of the cell into two daughters (cytokinesis) are regulated by the Anaphase Promoting Complex.<p>The Anaphase Promoting Complex or Cyclosome (APC/C) plays additional roles in <b>regulation of the mitotic cell cycle</b>, insuring the appropriate length of the G1 phase. The APC/C itself is regulated by phosphorylation and interactions with checkpoint proteins.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"53","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2019-12-10","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"54","dbId":453279,"displayName":"Mitotic G1 phase and G1/S transition","stId":"R-HSA-453279","stIdVersion":"R-HSA-453279.6","isInDisease":false,"isInferred":false,"maxDepth":5,"name":["Mitotic G1 phase and G1/S transition"],"releaseDate":"2010-03-16","speciesName":"Homo sapiens","literatureReference":[{"@id":"55","dbId":9028983,"displayName":"Life without kinase: cyclin E promotes DNA replication licensing and beyond","title":"Life without kinase: cyclin E promotes DNA replication licensing and beyond","author":[{"@id":"56","dbId":5672800,"displayName":"Zhang, H","firstname":"Hui","initial":"H","surname":"Zhang","className":"Person","schemaClass":"Person","publications":[{"@ref":"55"}]}],"journal":"Mol. Cell","pages":"175-6","pubMedIdentifier":17244524,"volume":25,"year":2007,"url":"h