evisiae","Sc","baker's yeast","brewer's yeast","Saccharomyces cerevisiae (strain RM11-1a)","Saccharomyces cerevisiae (strain YJM789)"],"taxId":"4932","abbreviation":"SCE","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"@id":"44","dbId":11170900,"displayName":"Neuronal System","stId":"R-PFA-112316","stIdVersion":"R-PFA-112316.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Neuronal System"],"releaseDate":"2026-09-16","speciesName":"Plasmodium falciparum","goBiologicalProcess":{"@ref":"9"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"45","dbId":170928,"displayName":"Plasmodium falciparum","name":["Plasmodium falciparum","malaria parasite P. falciparum"],"taxId":"5833","abbreviation":"PFA","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"}],"species":[{"@id":"46","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"47","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"48","dbId":349546,"displayName":"The human brain contains at least 100 billion neurons, each ...","text":"The human brain contains at least 100 billion neurons, each with the ability to influence many other cells. Clearly, highly sophisticated and efficient mechanisms are needed to enable communication among this astronomical number of elements. This communication occurs across synapses, the functional connection between neurons. Synapses can be divided into two general classes: electrical synapses and chemical synapses. Electrical synapses permit direct, passive flow of electrical current from one neuron to another. The current flows through gap junctions, specialized membrane channels that connect the two cells. Chemical synapses enable cell-to-cell communication using neurotransmitter release. Neurotransmitters are chemical agents released by presynaptic neurons that trigger a secondary current flow in postsynaptic neurons by activating specific receptor molecules. Neurotransmitter secretion is triggered by the influx of Ca2+ through voltage-gated channels, which gives rise to a transient increase in Ca2+ concentration within the presynaptic terminal. The rise in Ca2+ concentration causes synaptic vesicles (the presynaptic organelles that store neurotransmitters) to fuse with the presynaptic plasma membrane and release their contents into the space between the pre- and postsynaptic cells. ","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"49","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2022-06-09","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"50","dbId":112307,"displayName":"Transmission across Electrical Synapses ","stId":"R-HSA-112307","stIdVersion":"R-HSA-112307.3","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Transmission across Electrical Synapses "],"releaseDate":"2009-06-24","speciesName":"Homo sapiens","species":[{"@ref":"46"}],"doi":"10.3180/REACT_16881.2","hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","eventOfPathways":[{"type":"event","stoichiometry":1,"order":0,"element":{"@ref":"1"}}],"schemaClass":"Pathway","className":"Pathway"}},{"type":"event","stoichiometry":1,"order":1,"element":{"@id":"51","dbId":112315,"displayName":"Transmission across Chemical Synapses","stId":"R-HSA-112315","stIdVersion":"R-HSA-112315.8","isInDisease