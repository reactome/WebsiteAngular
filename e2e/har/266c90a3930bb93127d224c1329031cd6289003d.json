bn":"0079130356","className":"Book","schemaClass":"Book"}]}],"journal":"Hum Mutat","pages":"511-9","pubMedIdentifier":19224584,"volume":30,"year":2009,"url":"http://www.ncbi.nlm.nih.gov/pubmed/19224584","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@ref":"48"},{"@ref":"17"},{"@ref":"10"},{"@ref":"19"},{"@ref":"34"}],"reviewed":[{"@id":"58","dbId":9953115,"displayName":"Matthews, Lisa, 2025-05-28","dateTime":"2025-05-28 16:57:32","author":[{"@id":"59","dbId":142011,"displayName":"Matthews, L","firstname":"Lisa","initial":"L","orcidId":"0000-0001-5707-3065","project":"Reactome","surname":"Matthews","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"60","dbId":2457644,"displayName":"Coutinho, Maria, 2012-08-27","dateTime":"2012-08-27 13:40:51","author":[{"@id":"61","dbId":2457641,"displayName":"Coutinho, MF","firstname":"Maria","initial":"MF","surname":"Coutinho","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"62","dbId":2457645,"displayName":"Alves, Sandra, 2012-08-27","dateTime":"2012-08-27 13:44:23","author":[{"@id":"63","dbId":2457647,"displayName":"Alves, S","firstname":"Sandra","initial":"S","orcidId":"0000-0002-8881-9197","surname":"Alves","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"64","dbId":2457667,"displayName":"Ashworth, Jane, 2012-08-28","dateTime":"2012-08-28 13:44:11","author":[{"@id":"65","dbId":2457665,"displayName":"Ashworth, J","firstname":"Jane","initial":"J","surname":"Ashworth","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"66","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"67","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"68","dbId":2318386,"displayName":"Mucopolysaccharidosis type VII (MPS VII, Sly syndrome, beta-...","text":"Mucopolysaccharidosis type VII (MPS VII, Sly syndrome, beta-glucuronidase deficiency; MIM:253220) is an autosomal recessive lysosomal storage disease characterized by a deficiency of the enzyme beta-glucuronidase (GUSB; MIM:611499) which would normally cleave glucuronide residues from dematan sulphate, keratan sulphate and chondroitin sulphate, resulting in build up of these GAGs in cells and tissues (Sly et al. 1973). The gene encoding GUSB is 21 kb long, contains 12 exons and gives rise to two different types of cDNAs, through an alternate splicing mechanism (Miller et al. 1990). It maps to 7q11.21-q11.22 (Speleman et al. 1996). The phenotype is highly variable, ranging from severe causing death, non-immune hydrops fetalis (Vervoort et al. 1996) to mild forms with survival into adulthood (Storch et al. 2003). Most patients with the intermediate phenotype show hepatomegaly, skeletal anomalies, coarse facies, and variable degrees of mental impairment (Shipley et al. 1993, Tomatsu et al. 2009).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"69","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"previousReviewStatus":{"@id":"70","dbId":9821384,"displayName":"two stars","definition":"structure updated after externally and internally reviewed","name":["two stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2019-03-25","normalPathway":{"@id":"71","dbId":2142845,"displayName":"Hyaluronan metabolism","stId":"R-HSA-2142845","s