2,"displayName":"Mus musculus","name":["Mus musculus","M. musculus","Mm","house mouse"],"taxId":"10090","abbreviation":"MMU","className":"Species","schemaClass":"Species"}],"hasDiagram":false,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"reviewed":[{"@id":"88","dbId":165074,"displayName":"Manfredi, James J","dateTime":"2018-07-10 18:32:43","author":[{"@id":"89","dbId":6798281,"displayName":"Manfredi, JJ","firstname":"James J","initial":"JJ","surname":"Manfredi","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"90","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"91","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"92","dbId":69579,"displayName":"Most of the damage-induced modifications of p53 are dependen...","text":"Most of the damage-induced modifications of p53 are dependent on the ATM kinase. The first link between ATM and p53 was predicted based on the earlier studies that showed that AT cells exhibit a reduced and delayed induction of p53 following exposure to IR (Kastan et al, 1992 and Khanna and Lavin, 1993).<p>Under normal conditions, p53 is a short-lived protein.  The MDM2 protein, usually interacts with p53 (Haupt et al, 1997 and Kubbutat et al, 1997), and by virtue of its E3 ubiquitin ligase activity, shuttles p53 to the cytoplasm and mediates its degradation by the ubiquitin-proteasome machinery.  Upon detection of DNA damage, the ATM kinase mediates the phosphorylation of the Mdm2 protein to block its interaction with p53.  Also, phosphorylation of p53 at multiple loci, by the ATM kinase and by other kinases activated by the ATM kinase, stabilizes and activates the p53 protein.<p>The p53 protein activates the transcription of cyclin-dependent kinase inhibitor, p21. p21 inactivates the CyclinE:Cdk2 complexes, and prevent entry of the cell into S phase, leading to G1 arrest.  Under severe conditions, the cell may undergo apoptosis.  ","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"93","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2019-06-12","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"94","dbId":69541,"displayName":"Stabilization of p53","stId":"R-HSA-69541","stIdVersion":"R-HSA-69541.7","isInDisease":false,"isInferred":false,"maxDepth":3,"name":["Stabilization of p53"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","crossReference":[{"@ref":"8"},{"@ref":"9"},{"@ref":"10"},{"@ref":"11"},{"@ref":"12"},{"@ref":"13"},{"@ref":"14"},{"@ref":"15"},{"@ref":"16"},{"@ref":"17"},{"@ref":"18"},{"@ref":"19"},{"@ref":"20"},{"@ref":"21"},{"@ref":"22"},{"@ref":"23"}],"literatureReference":[{"@ref":"31"},{"@id":"95","dbId":69543,"displayName":"Chk2/hCds1 functions as a DNA damage checkpoint in G(1) by stabilizing p53.","title":"Chk2/hCds1 functions as a DNA damage checkpoint in G(1) by stabilizing p53.","author":[{"@id":"96","dbId":69544,"displayName":"Chehab, NH","initial":"NH","surname":"Chehab","className":"Person","schemaClass":"Person","publications":[{"@ref":"95"}]},{"@id":"97","dbId":69545,"displayName":"Malikzay, A","initial":"A","surname":"Malikzay","className":"Person","schemaClass":"Person","publications":[{"@ref":"95"}]},{"@id":"98","dbId":69546,"displayName":"Appel, M","initial":"M","surname":"Appel","className":"Person","schemaClass":"Person","publications":[{"@ref":"95"}]},{"@id":"99","dbId":69547,"displayName":"Halazonetis, 