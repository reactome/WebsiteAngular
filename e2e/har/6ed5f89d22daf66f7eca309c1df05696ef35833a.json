amiliaris","Canis lupus familiaris"],"taxId":"9615","abbreviation":"CFA","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"@id":"36","dbId":10228250,"displayName":"Biological oxidations","stId":"R-RNO-211859","stIdVersion":"R-RNO-211859.1","isInDisease":false,"isInferred":true,"maxDepth":6,"name":["Biological oxidations"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","goBiologicalProcess":{"@ref":"8"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"37","dbId":48895,"displayName":"Rattus norvegicus","name":["Rattus norvegicus","R. norvegicus","Rn","brown rat","Norway rat"],"taxId":"10116","abbreviation":"RNO","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"@id":"38","dbId":10104474,"displayName":"Biological oxidations","stId":"R-MMU-211859","stIdVersion":"R-MMU-211859.1","isInDisease":false,"isInferred":true,"maxDepth":6,"name":["Biological oxidations"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","goBiologicalProcess":{"@ref":"8"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"39","dbId":48892,"displayName":"Mus musculus","name":["Mus musculus","M. musculus","Mm","house mouse"],"taxId":"10090","abbreviation":"MMU","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"reviewed":[{"@id":"40","dbId":351775,"displayName":"D'Eustachio, P, 2008-05-28 08:30:54","dateTime":"2008-05-28 12:30:54","author":[{"@id":"41","dbId":140934,"displayName":"D'Eustachio, P","firstname":"Peter","initial":"P","orcidId":"0000-0002-5494-626X","project":"Reactome","surname":"D'Eustachio","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"42","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"43","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"44","dbId":76368,"displayName":"All organisms are constantly exposed to foreign chemicals ev...","text":"All organisms are constantly exposed to foreign chemicals every day. These can be man-made (drugs, industrial chemicals) or natural (alkaloids, toxins from plants and animals). Uptake is usually via ingestion but inhalation and transdermal routes are also common.<p><p>The very nature of many chemicals that make them suitable for uptake by these routes, in other words their lipophilicty (favours fat solubility) is also the main reason organisms have developed mechanisms that convert them to hydrophilic (favours water solubility) compounds which are readily excreted via bile and urine. Otherwise, lipophilic chemicals would accumulate in the body and overwhelm defense mechanisms. This process is called <b><i>biotransformation</i></b> and is catalyzed by enzymes mainly in the liver of higher organisms but a number of other organs have considerable ability to process xenobiotica such as kidneys, gut and lungs. As well as xenobiotics, many endogenous compounds are commonly eliminated by this process.<p><p>This mechanism is of ancient origin and a major factor for its development in animals is plants. Most animals are plant eaters and thus are subject to a huge variety of chemical compounds which plants produce to stop themselves being eaten. This complex set of enzymes have several features which make them ideal for biotransformation;<p><p><i>(<b>1</b>) metabolites of the parent chemical are usually made more water soluble so it favours rapid excretion via bile and urine</i><p><p><i>(<b>2</b>) the enzymes possess broad and overlapping specificity to be able to deal with newly exposed chemicals</i><p><p><i>(<b>3</b>) metabolites of the parent generally don't have adverse biological effects.</i><p><p>In the real world however, all these criteria have exceptions. Many chemicals are transformed into reactive metabolites. In pharmacology, the metabolites of some parent drugs exert the desired pharmacological effect but in the case of polycyclic aromatic hydrocarbons (PAHs), which can undergo epoxidation, it results in the formation of an electrophile which can attack proteins and DNA.<p><p>Metabolism of xenobiotica occurs in several steps called <i><b>Phase 1 (functionalization)</b></i> and <i><b>Phase 2 (conjugation)</b></i>. To improve water solubility, a functional group is added to or exposed on the chemical in one or more steps (Phase 1) to which hydrophilic conjugating species can be added (Phase 2). Functional groups can either be electrophilic (epoxides, carbonyl groups) or nucleophilic (hydroxyls, amino and sulfhydryl groups, carboxylic  groups) <i>(see picture)</i>.<p><p>Once chemicals undergo functionalization, the electrophilic or nucleophilic species can be detrimental to biological systems. Electrophiles can react with electron-rich macromolecules such as proteins, DNA and RNA by covalent interaction whilst nucleophiles have the potential to interact with biological receptors. That's why conjugation is so important as it mops up these potentially reactive species.<p><p>Many chemicals, when exposed to certain metabolizing enzymes can induce those  enzymes, a process called <i><b>enzyme induction</b></i>. The effect of this is that these chemicals accelerate their own biotransformation and excretion. The reverse is also true where some chemicals cause enzyme inhibition. Some other factors that alter enzyme levels are sex, age and genetic predisposition. Between species, there can be considerable differences in biotransformation ability which is a problem faced by drug researchers interpreting toxicological results to humans.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"45","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2023-09-13","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"46","dbId":211945,"displayName":"Phase I - Functionalization of compounds","stId":"R-HSA-211945","stIdVersion":"R-HSA-211945.8","isInDisease":false,"isInferred":false,"maxDepth":5,"name":["Phase I - Functionalization of compounds"],"releaseDate":"2008-06-30","speciesName":"Homo sapiens","goBiologicalProcess":{"@ref":"8"},"literatureReference":[{"@id":"47","dbId":266241,"displayName":"The cytochrome P450 superfamily: biochemistry, evolution and drug metabolism in humans","title":"The cytochrome P450 superfamily: biochemistry, evolution and drug metabolism in humans","author":[{"@id":"48","dbId":266231,"displayName":"Danielson, PB","initial":"PB","surname":"Danielson","className":"Person","schemaClass":"Person","publications":[{"@ref":"47"}]}],"journal":"Curr Drug Metab","pages":"561-97","pubMedIdentifier":12369887,"volume":3,"year":2002,"url":"http://www.ncbi.nlm.nih.gov/pubmed/12369887","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"49","dbId":266270,"displayName":"Involvement of enzymes other than CYPs in the oxidative metabolism of xenobiotics","title":"Involvement of enzymes other than CYPs in the oxidative metabolism of xenobiotics","author":[{"@id":"50","dbId":266257,"displayName":"Strolin Benedetti, M","initial":"M","surname":"Strolin Benedetti","className":"Person","schemaClass":"Person","publications":[{"@ref":"49"}]},{"@id":"51","dbId":266252,"displayName":"Whomsley, R","initial":"R","surname":"Whomsley","className":"Person","schemaClass":"Person","publications":[{"@ref":"49"}]},{"@id":"52","dbId"