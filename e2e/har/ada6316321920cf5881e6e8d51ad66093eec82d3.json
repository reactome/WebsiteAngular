evelPathway","className":"TopLevelPathway"},{"@id":"142","dbId":10228420,"displayName":"Programmed Cell Death","stId":"R-RNO-5357801","stIdVersion":"R-RNO-5357801.1","isInDisease":false,"isInferred":true,"maxDepth":8,"name":["Programmed Cell Death"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","goBiologicalProcess":{"@ref":"8"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"143","dbId":48895,"displayName":"Rattus norvegicus","name":["Rattus norvegicus","R. norvegicus","Rn","brown rat","Norway rat"],"taxId":"10116","abbreviation":"RNO","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"},{"@id":"144","dbId":10104644,"displayName":"Programmed Cell Death","stId":"R-MMU-5357801","stIdVersion":"R-MMU-5357801.1","isInDisease":false,"isInferred":true,"maxDepth":8,"name":["Programmed Cell Death"],"releaseDate":"2026-06-17","speciesName":"Mus musculus","goBiologicalProcess":{"@ref":"8"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"145","dbId":48892,"displayName":"Mus musculus","name":["Mus musculus","M. musculus","Mm","house mouse"],"taxId":"10090","abbreviation":"MMU","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"TopLevelPathway","className":"TopLevelPathway"}],"species":[{"@id":"146","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"147","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"148","dbId":5643916,"displayName":"Cell death is a fundamental cellular response that has a cru...","text":"Cell death is a fundamental cellular response that has a crucial role in shaping our bodies during development and in regulating tissue homeostasis by eliminating unwanted cells. There are a number of different forms of cell death, each with a corresponding number of complex subprocesses. The first form of regulated or programmed cell death to be characterized was apoptosis. Evidence has emerged for a number of regulated non-apoptotic cell death pathways, including some with morphological features that were previously attributed to necrosis. More recently necrosis has been subdivided into parts including programmed necrotic cell death processes, such as RIP1-mediated regulated necrosis or pyroptosis.<br>Reactome currently represents programmed cell death using the model of extrinsic signalling that leads to a molecular decision point pivoting on caspase-8 activation or inhibition. Caspase-8 activation tilts the cell towards apoptosis, while caspase-8 inhibition tilts the cell towards Regulated Necrosis.<p>The terminology and molecular definitions of cell death-related events annotated here are consistent with the 2015 recommendations of the Nomenclature Committee on Cell Death (NCCD) (Galluzzi L et al. 2015).","literatureReference":[{"@ref":"9"},{"@id":"149","dbId":5643926,"displayName":"Expansion and evolution of cell death programmes","title":"Expansion and evolution of cell death programmes","author":[{"@id":"150","dbId":5621047,"displayName":"Degterev, A","firstname":"Alexei","initial":"A","surname":"Degterev","className":"Person","schemaClass":"Person","publications":[{"@ref":"149"}]},{"@id":"151","dbId":3791099,"displayName":"Yuan, J","firstname":"Junying","initial":"J","surname":"Yuan","className":"Person","schemaClass":"Person","publications":[{"@ref":"149"}]}],"journal":"Nat. Rev. Mol. Cell Biol.","pages":"378-90","pubMedIdentifier":18414491,"volume":9,"year":2008,"url":"http://www.ncbi.nlm.nih.gov/pubmed/18414491","className":"LiteratureReference","schemaClass":"LiteratureReference"}],"className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"152","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2022-09-14","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"153","dbId":109581,"displayName":"Apoptosis","stId":"R-HSA-109581","stIdVersion":"R-HSA-109581.6","isInDisease":false,"isInferred":false,"maxDepth":7,"name":["Apoptosis"],"releaseDate":"2004-09-20","speciesName":"Homo sapiens","goBiologicalProcess":{"@id":"154","dbId":2273,"displayName":"apoptotic process","accession":"0006915","databaseName":"GO","definition":"A programmed cell death process which begins when a cell receives an internal (e.g. DNA damage) or external signal (e.g. an extracellular death ligand), and proceeds through a series of biochemical events (signaling pathway phase) which trigger an execution phase. The execution phase is the last step of an apoptotic process, and is typically characterized by rounding-up of the cell, retraction of pseudopodes, reduction of cellular volume (pyknosis), chromatin condensation, nuclear fragmentation (karyorrhexis), plasma membrane blebbing and fragmentation of the cell into apoptotic bodies. When the execution phase is completed, the cell has died.","name":"apoptotic process","url":"https://www.ebi.ac.uk/QuickGO/term/GO:0006915","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"literatureReference":[{"@id":"155","dbId":141074,"displayName":"Targeting death and decoy receptors of the tumour-necrosis factor superfamily","title":"Targeting death and decoy receptors of the tumour-necrosis factor superfamily","author":[{"@id":"156","dbId":141075,"displayName":"Ashkenazi, A","initial":"A","surname":"Ashkenazi","className":"Person","schemaClass":"Person","publications":[{"@ref":"155"}]}],"journal":"Nat Rev Cancer","pages":"420-30","pubMedIdentifie