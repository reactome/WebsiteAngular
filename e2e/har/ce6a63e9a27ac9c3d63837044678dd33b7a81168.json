cations":[{"@ref":"9"}]},{"@id":"64","dbId":9678341,"displayName":"Krajden, M","firstname":"Mel","initial":"M","surname":"Krajden","className":"Person","schemaClass":"Person","publications":[{"@ref":"9"}]},{"@id":"65","dbId":9678336,"displayName":"Petric, M","firstname":"Martin","initial":"M","surname":"Petric","className":"Person","schemaClass":"Person","publications":[{"@ref":"9"}]},{"@id":"66","dbId":9678328,"displayName":"Skowronski, DM","firstname":"Danuta M","initial":"DM","surname":"Skowronski","className":"Person","schemaClass":"Person","publications":[{"@ref":"9"}]},{"@id":"67","dbId":9678331,"displayName":"Upton, C","firstname":"Chris","initial":"C","surname":"Upton","className":"Person","schemaClass":"Person","publications":[{"@ref":"9"}]},{"@id":"68","dbId":9678333,"displayName":"Roper, RL","firstname":"Rachel L","initial":"RL","surname":"Roper","className":"Person","schemaClass":"Person","publications":[{"@ref":"9"}]}],"journal":"Science","pages":"1399-404","pubMedIdentifier":12730501,"volume":300,"year":2003,"url":"http://www.ncbi.nlm.nih.gov/pubmed/12730501","className":"LiteratureReference","schemaClass":"LiteratureReference"}],"reviewed":[{"@id":"69","dbId":9690206,"displayName":"Acencio, Marcio Luis, Mazein, Alexander, 2020-05-27","dateTime":"2020-05-27 15:06:10","author":[{"@id":"70","dbId":9690208,"displayName":"Acencio, ML","firstname":"Marcio Luis","initial":"ML","orcidId":"0000-0002-8278-240X","surname":"Acencio","className":"Person","schemaClass":"Person"},{"@id":"71","dbId":9690204,"displayName":"Mazein, A","firstname":"Alexander","initial":"A","orcidId":"0000-0001-7137-4171","surname":"Mazein","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"72","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"73","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"74","dbId":9683878,"displayName":"Coronaviruses (CoVs) are large, enveloped, positive strand R...","text":"Coronaviruses (CoVs) are large, enveloped, positive strand RNA viruses that can be classified into four genera: alpha, beta, delta, and gamma. Coronaviruses are ecologically diverse, infecting animals including camels, cattle, cats, and bats, with the greatest variety seen in bats, suggesting that bats are the reservoirs for many of these viruses. Rarely, A and B lineage beta coronaviruses of non-human origin can infect people and then spread directly between people. Four human coronaviruses (HCoVs), HCoV 229E, NL63, OC43, and HKU1, are endemic globally and account for 10% to 30% of upper respiratory tract infections in adults, typically presenting as common colds (van der Hoek 2007). However, in the 21st century, three highly pathogenic HCoVs - severe acute respiratory syndrome coronavirus (SARS-CoV-1) in 2003, Middle East Respiratory Syndrome coronavirus (MERS CoV) in 2012, and SARS-CoV-2 in 2019 - emerged from animal reservoirs to cause global epidemics with alarming morbidity and mortality (De Wit et al. 2016; Fung & Liu 2019; Marra et al. 2003; Paules et al. 2020).<br><br>During the 2003 outbreak of SARS-CoV-1, 8,098 people worldwide became sick. Of these, 774 died. In the United States, only eight people had laboratory evidence of SARS-CoV-1 infection. All of these people had traveled to other parts of the world where the disease was spreading. Community spread was not observed in the United States (De Wit et al. 2016; WHO - SARS). A second human coronavirus, MERS-CoV, first observed in 2012, has been identified in 2,494 patients with respiratory distress of whom 858 have died. Human-to-human transmission of the virus appears to be limited (De Wit et al. 2016; WHO – MERS). <br><br>In December 2019, yet another pathogenic HCoV, 2019 novel coronavirus (2019 nCoV), was recognized, initially in Wuhan, China. The World Health Organization has named the disease caused by the 2019 novel coronavirus COronaVIrus Disease 2019, or COVID-19. The disease has also been referred to as 2019 novel coronavirus or 2019 nCoV. <br><br>SARS-CoV-1 and SARS-CoV-2 viral infection pathways are annotated in this section, as are drugs that potentially modulate the infection processes. Many of the steps of SARS-CoV-1 infection have been characterized experimentally in the past 15 years (Fung & Liu 2019; Masters 2006), and this experimental work has allowed the annotation here of the infection process and interactions with host proteins in molecular detail. Less comparable data is yet available for SARS-CoV-2 infection, but the similarity in the genomes and predicted proteomes of the two viruses allows the inference of a detailed infection pathway for SARS-CoV-2 that has been manually annotated as well with experimental results published in the first half of 2020.","literatureReference":[{"@id":"75","dbId":9683869,"displayName":"Coronavirus Infections-More Than Just the Common Cold","title":"Coronavirus Infections-More Than Just the Common Cold","author":[{"@id":"76","dbId":9683877,"displayName":"Paules, CI","firstname":"Catharine I","initial":"CI","surname":"Paules","className":"Person","schemaClass":"Person","publications":[{"@ref":"75"}]},{"@id":"77","dbId":9683885,"displayName":"Marston, HD","firstname":"Hilary D","initial":"HD","surname":"Marston","className":"Person","schemaClass":"Person","publications":[{"@ref":"75"}]},{"@id":"78","dbId":9683898,"displayName":"Fauci, AS","firstname":"Anthony S","initial":"AS","surname":"Fauci","className":"Person","schemaClass":"Person","publications":[{"@ref":"75"}]}],"journal":"JAMA","pubMedIdentifier":31971553,"year":2020,"url":"http://www.ncbi.nlm.nih.gov/pubmed/31971553","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"79","dbId":9683870,"displayName":"SARS and MERS: recent insights into emerging coronaviruses","title":"SARS and MERS: recent insights into emerging coronaviruses","author":[{"@id":"80","dbId":9683873,"displayName":"de Wit, E","firstname":"Emmie","initial":"E","surname":"de Wit","className":"Person","schemaClass":"Person","publications":[{"@ref":"79"}]},{"@id":"81","dbId":9683894,"displayName":"van Doremalen, N","firstname":"Neeltje","initial":"N","surname":"van Doremalen","className":"Person","schemaClass":"Person","publications":[{"@ref":"79"}]},{"@id":"82","dbId":9683886,"displayName":"Falzarano, D","firstname":"Darryl","initial":"D","surname":"Falzarano","className":"Person","schemaClass":"Person","publications":[{"@ref":"79"}]},{"@id":"83","dbId":9683891,"displayName":"Munster, VJ","firstname":"Vincent J","initial":"VJ","surname":"Munster","className":"Person","schemaClass":"Person","publications":[{"@ref":"79"}]}],"journal":"Nat. Rev. Microbiol.","pages":"523-34","pubMedIdentifier":27344959,"volume":14,"year":2016,"url":"http://www.ncbi.nlm.nih.gov/pubmed/27344959","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"84","dbId":9683883,"displayName":"978-3-030-05369-7 Tripp, R Host Factors in Coronavirus Replication Roles of Host Gene and Non-coding RNA Expression in Virus Infection","title":"Roles of Host Gene and Non-coding RNA Expression in Virus Infection","author":[{"@id":"85","dbId":9683867,"displayName":"Tripp, R","initial":"R","surname":"Tripp","className":"Person","schemaClass":"Person","publications":[{"@ref":"84"}]},{"@id":"86","dbId":9683862,"displayName":"Tompkins, S.","initial":"S.","surname":"Tompkins","className":"Person","schemaClass":"Person","publications":[{"@ref":"84"}]}],"chapterTitle":"Host Factors in Coronavirus Replication","year":2017,"isbn":"978-3-030-05369-7","className":"Book","schemaClass":"Book"},{"@i