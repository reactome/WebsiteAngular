y":1,"order":0,"element":{"@ref":"32"}}],"schemaClass":"Pathway","className":"Pathway"}],"reviewed":[{"@id":"59","dbId":5663080,"displayName":"Borowiec, James, 2015-01-07","dateTime":"2015-01-07 05:00:00","author":[{"@id":"60","dbId":69375,"displayName":"Borowiec, JA","firstname":"James A","initial":"JA","surname":"Borowiec","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"revised":[{"@ref":"6"}],"species":[{"@id":"61","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"62","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"63","dbId":110560,"displayName":"In addition to various processes for removing lesions from t...","text":"In addition to various processes for removing lesions from the DNA, cells have developed specific mechanisms for tolerating unrepaired damage during the replication of the genome. These mechanisms are collectively called DNA damage bypass pathways. The Y family of DNA polymerases plays a key role in DNA damage bypass. <p>Y family DNA polymerases, REV1, POLH (DNA polymerase eta), POLK (DNA polymerase kappa) and POLI (DNA polymerase iota), as well as the DNA polymerase zeta (POLZ) complex composed of REV3L and MAD2L2, are able to carry out translesion DNA synthesis (TLS) or replicative bypass of damaged bases opposite to template lesions that arrest high fidelity, highly processive replicative DNA polymerase complexes delta (POLD) and epsilon (POLE). REV1, POLH, POLK, POLI and POLZ lack 3'->5' exonuclease activity and exhibit low fidelity and weak processivity. The best established TLS mechanisms are annotated here. TLS details that require substantial experimental clarification have been omitted. For recent and past reviews of this topic, please refer to Lehmann 2000, Friedberg et al. 2001, Zhu and Zhang 2003, Takata and Wood 2009, Ulrich 2011, Saugar et al. 2014.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"64","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"doi":"10.3180/REACT_2174.4","hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2019-06-12","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"65","dbId":110314,"displayName":"Recognition of DNA damage by PCNA-containing replication complex","stId":"R-HSA-110314","stIdVersion":"R-HSA-110314.5","isInDisease":false,"isInferred":false,"maxDepth":2,"name":["Recognition of DNA damage by PCNA-containing replication complex"],"releaseDate":"2015-03-19","speciesName":"Homo sapiens","crossReference":[{"@id":"66","dbId":12829054,"displayName":"BioModels Database:BIOMD0000000660","databaseName":"BioModels Database","identifier":"BIOMD0000000660","url":"https://www.ebi.ac.uk/biomodels/BIOMD0000000660","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"goBiologicalProcess":{"@id":"67","dbId":6792104,"displayName":"positive regulation of error-prone translesion synthesis","accession":"1904333","databaseName":"GO","definition":"Any process that activates or increases the frequency, rate or extent of error-prone translesion synthesis.","name":"positive regulation of error-prone translesion synthesis","url":"https://www.ebi.ac.uk/QuickGO/term/GO:1904333","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"literatureReference":[{"@id":"68","dbId":5653644,"displayName":"Trading places: how do DNA polymerases switch during translesion DNA synthesis?","title":"Trading places: how do DNA polymerases switch during translesion DNA synthesis?","aut