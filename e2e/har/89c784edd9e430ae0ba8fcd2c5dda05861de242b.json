ackelford et al. 1999). Failure of DNA damage checkpoints in G1 leads to mutagenic replication of damaged templates and other replication defects.","literatureReference":[{"@ref":"14"},{"@ref":"16"}],"className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"49","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"doi":"10.3180/REACT_2254.1","hasDiagram":false,"hasEHLD":false,"lastUpdatedDate":"2017-06-22","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"50","dbId":69580,"displayName":"p53-Dependent G1/S DNA damage checkpoint","stId":"R-HSA-69580","stIdVersion":"R-HSA-69580.5","isInDisease":false,"isInferred":false,"maxDepth":5,"name":["p53-Dependent G1/S DNA damage checkpoint"],"releaseDate":"2004-07-06","speciesName":"Homo sapiens","literatureReference":[{"@id":"51","dbId":69582,"displayName":"Wild-type p53 is a cell cycle checkpoint determinant following irradiation.","title":"Wild-type p53 is a cell cycle checkpoint determinant following irradiation.","author":[{"@id":"52","dbId":69583,"displayName":"Kuerbitz, SJ","initial":"SJ","surname":"Kuerbitz","className":"Person","schemaClass":"Person","publications":[{"@ref":"51"}]},{"@id":"53","dbId":69576,"displayName":"Plunkett, BS","initial":"BS","surname":"Plunkett","className":"Person","schemaClass":"Person","publications":[{"@ref":"51"}]},{"@id":"54","dbId":69575,"displayName":"Walsh, WV","initial":"WV","surname":"Walsh","className":"Person","schemaClass":"Person","publications":[{"@ref":"51"}]},{"@id":"55","dbId":69503,"displayName":"Kastan, MB","initial":"MB","surname":"Kastan","className":"Person","schemaClass":"Person","publications":[{"@ref":"51"}]}],"journal":"Proc Natl Acad Sci U S A","pages":"7491-5","pubMedIdentifier":1323840,"volume":89,"year":1992,"url":"http://www.ncbi.nlm.nih.gov/pubmed/1323840","className":"LiteratureReference","schemaClass":"LiteratureReferen