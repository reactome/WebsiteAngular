isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Transmission across Chemical Synapses"],"releaseDate":"2026-09-16","speciesName":"Saccharomyces cerevisiae","goBiologicalProcess":{"@ref":"9"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"43","dbId":68322,"displayName":"Saccharomyces cerevisiae","name":["Saccharomyces cerevisiae","S.cerevisiae","S. cerevisiae","Sc","baker's yeast","brewer's yeast","Saccharomyces cerevisiae (strain RM11-1a)","Saccharomyces cerevisiae (strain YJM789)"],"taxId":"4932","abbreviation":"SCE","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"},{"@id":"44","dbId":11170898,"displayName":"Transmission across Chemical Synapses","stId":"R-PFA-112315","stIdVersion":"R-PFA-112315.1","isInDisease":false,"isInferred":true,"maxDepth":6,"name":["Transmission across Chemical Synapses"],"releaseDate":"2026-09-16","speciesName":"Plasmodium falciparum","goBiologicalProcess":{"@ref":"9"},"inferredFrom":[{"@ref":"1"}],"species":[{"@id":"45","dbId":170928,"displayName":"Plasmodium falciparum","name":["Plasmodium falciparum","malaria parasite P. falciparum"],"taxId":"5833","abbreviation":"PFA","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":false,"schemaClass":"Pathway","className":"Pathway"}],"reviewed":[{"@id":"46","dbId":9674802,"displayName":"Wen, Hua, 2020-01-24","dateTime":"2020-01-24 14:37:34","author":[{"@id":"47","dbId":9674799,"displayName":"Wen, H","firstname":"Hua","initial":"H","surname":"Wen","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"},{"@id":"48","dbId":387389,"displayName":"Restituito, S, Kavalali, E, 2008-12-02 04:33:19","dateTime":"2008-12-02 01:33:19","author":[{"@id":"49","dbId":386896,"displayName":"Restituito, S","firstname":"Sophie","initial":"S","surname":"Restituito","className":"Person","schemaClass":"Person"},{"@id":"50","dbId":349558,"displayName":"Kavalali, E","firstname":"Ege","initial":"E","surname":"Kavalali","className":"Person","schemaClass":"Person"}],"className":"InstanceEdit","schemaClass":"InstanceEdit"}],"species":[{"@id":"51","dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","crossReference":[{"@id":"52","dbId":72938,"displayName":"NCBI_taxonomy:9606","databaseName":"NCBI Taxonomy","identifier":"9606","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=9606","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"53","dbId":349539,"displayName":"Chemical synapses are specialized junctions that are used fo...","text":"Chemical synapses are specialized junctions that are used for communication between neurons, neurons and muscle or gland cells. The synapse involves a presynaptic neuron and a postsynaptic neuron, muscle cell or glad cell. The pre and the postsynaptic cell are separated by a gap (space) of 20 to 40 nm called the synaptic cleft. The signals pass in a single direction from the presynaptic to postsynaptic neuron (cell). The presynaptic neuron communicates via the release of neurotransmitter which bind the receptors on the postsynaptic cell. The process is initiated when an action potential invades the terminal membrane of the presynaptic neuron.<br>\n\nAction potentials occur in electrically excitable cells such as neurons and muscles and endocrine cells. They are initiated by the transient opening of voltage dependent sodium channels, causing a rapid, large depolarization of membrane potentials that spread along the axon membrane.<br>\n\nWhen action potentials arrive at the synaptic terminals, depolarization in membrane potential leads to the opening of voltage gated calcium channels located on the presynaptic membrane. The external Ca2+ concentration is approximately 10-3 M while the internal Ca2+ concentration is approximately 10-7 M. Opening of calcium channels causes a rapid influx of Ca2+ into the presynaptic terminal. The elevated presynaptic Ca2+ concentration allows synaptic vesicles to fuse with the plasma membrane of the presynaptic neuron and release their contents, neurotransmitters, into the synaptic cleft. These diffuse across the synaptic cleft and bind to specific receptors on the membrane of the postsynaptic cells. Activation of postsynaptic receptors upon neurotransmitter binding can lead to a multitude of effects in the postsynaptic cell, such as changing the membrane potential and excitability, and triggering intracellular signaling cascades.","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"@id":"54","dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2022-06-09","events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"55","dbId":112308,"displayName":"Presynaptic depolarization and calcium channel opening","stId":"R-HSA-112308","stIdVersion":"R-HSA-112308.7","isInDisease":false,"isInferred":false,"maxDepth":2,"name":["Presynaptic depolarization and calcium channel opening"],"releaseDate":"2008-06-30","speciesName":"Homo sapiens","goBiologicalProcess":{"@id":"56","dbId":262351,"displayName":"membrane depolarization","accession":"0051899","databaseName":"GO","definition":"\"The process in which membrane potential decreases with respect to its steady-state potential, usually from negative potential to a more positive potential. For example, the initial depolarization during the rising phase of an action potential is in the direction from the negative steady-state resting potential towards the positive membrane potential that will be the peak of the action potential.\" [GOC:dh, Wikipedia:Depolarization]","name":"membrane depolarization","url":"https://www.ebi.ac.uk/QuickGO/term/GO:0051899","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"species":[{"@ref":"51"}],"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2020-03-16","eventOfPathways":[{"type":"event","stoichiometry":1,"order":0,"element":{"@ref":"1"}}],"schemaClass":"Pathway","className":"Pathway"}},{"type":"event","stoichiometry":1,"order":1,"element":{"@id":"57","dbId":112310,"displayName":"Neurotransmitter release cycle","stId":"R-HSA-112310","stIdVersion":"R-HSA-112310.8","isInDisease":false,"isInferred":false,"maxDepth":4,"name":["Neurotransmitter release cycle"],"releaseDate":"2008-06-30","speciesName":"Homo sapiens","goBiologicalProcess":{"@id":"58","dbId":20323,"displayName":"neurotransmitter secretion","accession":"0007269","databaseName":"GO","definition":"\"The regulated release of neurotransmitter from the presynapse into the synaptic cleft via calcium-regulated exocytosis during synaptic transmission.\" [GOC:dph]","name":"neurotransmitter secretion","url":"https://www.ebi.ac.uk/QuickGO/term/GO:0007269","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"literatureReference":[{"@id":"59","dbId":379284,"displayName":"Vesicle pools, docking, priming, and release","title":"Vesicle pools, docking, priming, and release","author":[{"@id":"60","dbId":379285,"displayName":"Becherer, U","initial":"U","surname":"Becherer","className":"Person","schemaClass":"Person","publications":[{"@ref":"59"}]},{"@id":"61","dbId":379287,"displayName":"Rettig, J","initial":"J","surname":"Rettig","className":"Person","schemaClass":"Person","publications":[{"@ref":"59"}]}],"journal":"Cell Tissue Res","pages":"393-407","pubMedIdentifier":16819626,"volume":326,"year":2006,"url":"http://www.ncbi.nlm.nih.gov/pubmed/16819626","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"62","dbId":379286,"displayName":"Molecular organization of the presynaptic active zone","title":"Molecular organization of the presynaptic active zone","author":[{"@id":"63","dbId":379288,"displayName":"Schoch, S","initial":"S","surname":"Schoch","className":"Person","schemaClass":"Person","publications":[{"@ref":"62"}]},{"@id":"64","dbId":379282,"displayName":"Gundelfinger, ED","initial":"ED","surname":"Gundelfinger","className":"Person","schemaClass":"Person","publications":[{"@ref":"62"}]}],"journal":"Cell Tissue Res","pages":"379-91","pubMedIdentifier":16865347,"volume":326,"year":2006,"url":"http://www.ncbi.nlm.nih.gov/pubmed/16865347","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"65","dbId":379281,"displayName":"The synaptic vesicle cycle","title":"The synaptic vesicle cycle","author":[{"@id":"66","dbId":2328158,"displayName":"Südhof, TC","firstname":"Thomas C","initial":"TC","surname":"Südhof","className":"Person","schemaClass":"Person","publications":[{"@ref":"65"}]}],"journal":"Annu Rev Neurosci","pages":"509-47","pubMedIdentifier":15217342,"volume":27,"year":2004,"url":"http://www.ncbi.nlm.nih.gov/pubmed/15217342","className":"LiteratureReference","schemaClass":"LiteratureReference"},{"@id":"67","dbId":349561,"displayName":"The neurotransmitter cycle and quantal size","title":"The neurotransmitter cycle and quantal size","author":[{"@id":"68","dbId":167065,"displayName":"Edwards, RH","initial":"RH","surname":"Edwards","className":"Person","schemaClass":"Person","publications":[{"@ref":"67"}]}],"journal":"Neuron","pages":"835-58","pubMedIdentifier":17880890,"volume":55,"year":2007,"url":"http://www.ncbi.nlm.nih.gov/pubmed/17880890","className":"LiteratureReference","schemaClass":"LiteratureReference"}],"species":[{"@ref":"51"}],"hasDiagram":true,"hasEHLD":false,"lastUpdatedDate":"2023-09-13","eventOfPathways":[{"type":"event","stoichiometry":1,"order":1,"element":{"@ref":"1"}}],"schemaClass":"Pathway","className":"Pathway"}},{"type":"event","stoichiometry":1,"order":2,"element":{"@id":"69","dbId":112311,"displayName":"Neurotransmitter clearance","stId":"R-HSA-1