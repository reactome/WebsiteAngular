n":"HSA","className":"Species","schemaClass":"Species"}],"hasDiagram":true,"hasEHLD":true,"lastUpdatedDate":"2022-09-14","schemaClass":"TopLevelPathway","className":"TopLevelPathway"}],"species":[{"@id":"117","dbId":48895,"displayName":"Rattus norvegicus","name":["Rattus norvegicus","R. norvegicus","Rn","brown rat","Norway rat"],"taxId":"10116","crossReference":[{"@id":"118","dbId":73099,"displayName":"NCBI_taxonomy:10116","databaseName":"NCBI Taxonomy","identifier":"10116","url":"https://www.ncbi.nlm.nih.gov/Taxonomy/Browser/wwwtax.cgi?mode=Info&id=10116","className":"DatabaseIdentifier","schemaClass":"DatabaseIdentifier"}],"abbreviation":"RNO","className":"Species","schemaClass":"Species"}],"summation":[{"@id":"119","dbId":9990864,"displayName":"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>","text":"This event has been computationally inferred from an event that has been demonstrated in another species.<p>The inference is based on the homology mapping from PANTHER. Briefly, reactions for which all involved PhysicalEntities (in input, output and catalyst) have a mapped orthologue/paralogue (for complexes at least 75% of components must have a mapping) are inferred to the other species. High level events are also inferred for these events to allow for easier navigation.<p><a href='/electronic_inference_compara.html' target = 'NEW'>More details and caveats of the event inference in Reactome.</a> For details on PANTHER see also: <a href='http://www.pantherdb.org/about.jsp' target='NEW'>http://www.pantherdb.org/about.jsp</a>","className":"Summation","schemaClass":"Summation"}],"hasDiagram":true,"hasEHLD":false,"events":[{"type":"event","stoichiometry":1,"order":0,"element":{"@id":"120","dbId":10228418,"displayName":"Apoptosis","stId":"R-RNO-109581","stIdVersion":"R-RNO-109581.1","isInDisease":false,"isInferred":true,"maxDepth":7,"name":["Apoptosis"],"releaseDate":"2026-06-17","speciesName":"Rattus norvegicus","goBiologicalProcess":{"@id":"121","dbId":2273,"displayName":"apoptotic process","accession":"0006915","databaseName":"GO","definition":"A programmed cell death process which begins when a cell receives an internal (e.g. DNA damage) or external signal (e.g. an extracellular death ligand), and proceeds through a series of biochemical events (signaling pathway phase) which trigger an execution phase. The execution phase is the last step of an apoptotic process, and is typically characterized by rounding-up of the cell, retraction of pseudopodes, reduction of cellular volume (pyknosis), chromatin condensation, nuclear fragmentation (karyorrhexis), plasma membrane blebbing and fragmentation of the cell into apoptotic bodies. When the execution phase is completed, the cell has died.","name":"apoptotic process","url":"https://www.ebi.ac.uk/QuickGO/term/GO:0006915","className":"GO_BiologicalProcess","schemaClass":"GO_BiologicalProcess"},"species":[{"@ref":"117"}],"hasDiagram":true,"hasEHLD":false,"eventOfPathways":[{"type":"event","stoichiometry":1,"order":0,"element":{"@ref":"1"}}],"schemaClass":"Pathway","className":"Pathway"}},{"type":"event","stoichiometry":1,"order":1,"element":{"@id":"122","dbId":10228766,"displayName":"Regulated Necrosis","stId":"R-RNO-5218859","stIdVersion":"R-RNO-5218859.1","isInDisease":false,"isInferred":true,"maxDepth":5,"name"