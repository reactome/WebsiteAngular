{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "reactome": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/reactome",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "projects/website-angular/public"
              },
              {
                "glob": "**/*",
                "input": "projects/pathway-browser/public"
              },
              {
                "glob": "**/*",
                "input": "projects/website-angular/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/pathway-browser/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/website-angular/content-dist",
                "output": "/content"
              }
            ],
            "allowedCommonJsDependencies": [
              "svgcanvas",
              "svg-pan-zoom",
              "@swissprot/rhea-reaction-viz-test",
              "cytoscape-fcose",
              "lodash"
            ],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/", "dist/"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "450kB",
                  "maximumError": "550kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "APP_ENV": "\"production\""
              }
            },
            "development": {
              "define": {
                "APP_ENV": "\"development\""
              },
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "curator": {
              "baseHref": "/curatorgraph/",
              "define": {
                "APP_ENV": "\"curator\""
              }
            },
            "curator-local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "APP_ENV": "\"curator-local\""
              }
            },
            "beta": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "450kB",
                  "maximumError": "550kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "APP_ENV": "\"beta\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.js"
          },
          "configurations": {
            "production": {
              "buildTarget": "reactome:build:production"
            },
            "development": {
              "buildTarget": "reactome:build:development"
            },
            "curator": {
              "buildTarget": "reactome:build:development,curator"
            },
            "curator-local": {
              "buildTarget": "reactome:build:curator-local",
              "proxyConfig": "proxy.curator-local.conf.json"
            },
            "beta": {
              "buildTarget": "reactome:build:beta"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": []
          }
        }
      }
    },
    "reactome-table": {
      "projectType": "library",
      "root": "projects/reactome-table",
      "sourceRoot": "projects/reactome-table/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/reactome-table/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/reactome-table/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/reactome-table/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/reactome-table/tsconfig.spec.json"
          }
        }
      }
    },
    "reactome-gsa-form": {
      "projectType": "library",
      "root": "projects/reactome-gsa-form",
      "sourceRoot": "projects/reactome-gsa-form/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/reactome-gsa-form/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/reactome-gsa-form/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/reactome-gsa-form/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/reactome-gsa-form/tsconfig.spec.json"
          }
        }
      }
    },
    "reactome-table-wc": {
      "projectType": "application",
      "root": "projects/reactome-table-wc",
      "sourceRoot": "projects/reactome-table-wc/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/reactome-table-wc"
            },
            "index": "projects/reactome-table-wc/src/index.html",
            "tsConfig": "projects/reactome-table-wc/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [],
            "styles": ["projects/reactome-table/src/assets/_index.scss"],
            "scripts": [],
            "browser": "projects/reactome-table-wc/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "5kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "reactome-table-wc:build:production"
            },
            "development": {
              "buildTarget": "reactome-table-wc:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/reactome-table-wc/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "styles": [],
            "scripts": []
          }
        }
      }
    },
    "reactome-diagram-element": {
      "projectType": "application",
      "root": "projects/reactome-diagram-element",
      "sourceRoot": "projects/reactome-diagram-element/src",
      "prefix": "reactome",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/reactome-diagram",
            "browser": "projects/reactome-diagram-element/src/main.ts",
            "index": false,
            "polyfills": [],
            "tsConfig": "projects/reactome-diagram-element/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": [],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules/", "dist/"]
            },
            "outputHashing": "none",
            "namedChunks": false,
            "crossOrigin": "anonymous",
            "assets": [
              {
                "glob": "**/*.{gif,webm,svg,png}",
                "input": "node_modules/ngx-reactome-cytoscape-style/assets",
                "output": "/"
              },
              {
                "glob": "reactome-diagram.js",
                "input": "projects/reactome-diagram-element/src/loader",
                "output": "/"
              },
              {
                "glob": "demo.html",
                "input": "projects/reactome-diagram-element",
                "output": "/"
              },
              {
                "glob": "*.svg",
                "input": "projects/pathway-browser/src/assets/EHLD-legend",
                "output": "EHLD-legend"
              }
            ],
            "allowedCommonJsDependencies": [
              "cytoscape",
              "cytoscape-fcose",
              "lodash",
              "svgcanvas",
              "svg-pan-zoom"
            ]
          },
          "configurations": {
            "production": {
              "define": {
                "APP_ENV": "\"embed-production\""
              },
              "deployUrl": "https://reactome.org/embed/diagram/v1/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.65MB",
                  "maximumError": "1.8MB"
                }
              ]
            },
            "beta": {
              "define": {
                "APP_ENV": "\"embed-beta\""
              },
              "deployUrl": "https://beta.reactome.org/embed/diagram/v1/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.65MB",
                  "maximumError": "1.8MB"
                }
              ]
            },
            "development": {
              "define": {
                "APP_ENV": "\"embed-development\""
              },
              "deployUrl": "http://localhost:4340/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "50c0c135-7597-4d12-af2a-c2f05c84c5b1"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
