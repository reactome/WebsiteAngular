# Copy to .env so the dev container runs as you rather than as root:
#
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" > .env
#
# Without this the container writes root-owned files into your working copy
# (.angular/cache in particular), which breaks host-side builds and cannot be
# deleted without sudo.
UID=1000
GID=1000
