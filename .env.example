# Copy to .env so the dev container runs as you rather than as root:
#
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" > .env
#
# Without this the container writes root-owned files into your working copy
# (.angular/cache in particular), which breaks host-side builds and cannot be
# deleted without sudo.
UID=1000
GID=1000

# Beta's content service: this host's folder of release diagram files for the
# release the graph serves ({stId}.json), mounted read-only for an event's SBGN.
# Unset, a pathway's SBGN answers 503.
# DIAGRAM_FILES_DIR=/path/to/release/diagram

# Beta's content service: this host's folder of Expression Atlas tables for the
# Expression tab (spec 024), written by
#   node tools/content-node/snapshot-expression.ts --out <folder>
# and mounted read-only. Unset, the heatmap answers 503.
# EXPRESSION_FILES_DIR=/path/to/expression

# The graph database container (docker-compose.yml's `graphdb`) runs only when
# this names `graph`. Beta sets it; a host with its own graph database leaves it
# out (specs/032 D4). Unset on beta, `docker compose up` would not start the graph.
# COMPOSE_PROFILES=graph
