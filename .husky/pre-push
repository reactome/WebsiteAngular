# Everything CI checks, before the push rather than after the email.
#
# The end-to-end smoke runs against `ng serve` with a public backend and no
# render service, because that is CI's configuration and it is the one local
# checks against beta.reactome.org cannot reproduce.
#
# `git push --no-verify` skips this.

# See `scripts/select-node.sh`: without this the hook runs on the system Node,
# and preflight reports four failures that are all the Node version.
. scripts/select-node.sh || exit 1

npm run preflight
